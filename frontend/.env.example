# Variables de entorno del frontend de PROTEC
# Copia este archivo como .env y ajusta los valores.
# Nunca coloques secretos aquí: todo lo que empieza con VITE_ es público en el navegador.

# URL base de la API (en producción: https://tu-backend.up.railway.app/api)
VITE_API_URL=http://localhost:4000/api

# URL del servidor de Socket.IO (en producción: https://tu-backend.up.railway.app)
VITE_SOCKET_URL=http://localhost:4000

# Solo para maquetar sin backend. En producción déjalo en false o no lo definas.
VITE_USE_MOCKS=false

# Las fotografías se suben a Cloudinary a través del backend y los pagos se procesan con Stripe
# desde el backend: sus credenciales solo existen en backend/.env.

# --- Datos del negocio (se muestran en el pie de página, Ayuda y documentos legales) ---
# Deja vacío lo que no quieras mostrar. Nombre o razón social del responsable (obligatorio para el Aviso de privacidad).
VITE_BUSINESS_NAME=PROTEC
VITE_BUSINESS_LEGAL_NAME="Cristian Javier Padilla Cornejo, Jessica Pedraza Quintana, Gael Ceja de Anda, Edwin Daniel Carvajal López y Mario Abraham Murillo García"
VITE_BUSINESS_RFC=
VITE_BUSINESS_ADDRESS=
VITE_BUSINESS_EMAIL=cristianpadilla1108@gmail.com
# Correo para solicitudes de privacidad (derechos ARCO). Si se omite, se usa VITE_BUSINESS_EMAIL.
VITE_BUSINESS_PRIVACY_EMAIL=
VITE_BUSINESS_PHONE=
# WhatsApp con lada internacional, solo números (ej. 5215512345678)
VITE_BUSINESS_WHATSAPP=
VITE_BUSINESS_HOURS=
# Fecha de la última actualización de Términos y Aviso de privacidad
VITE_LEGAL_UPDATED=
