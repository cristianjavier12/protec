# ==========================================================
# PROTEC · Variables de entorno del BACKEND
# Copia este archivo como `.env` y completa los valores.
# NUNCA subas el archivo .env real al repositorio.
# ==========================================================

# --- Servidor ---
PORT=4000
NODE_ENV=development
# URL pública del backend (en producción: https://tu-backend.up.railway.app)
PUBLIC_URL=http://localhost:4000
# URL pública del frontend (enlaces de correo y regreso de Stripe)
FRONTEND_URL=http://localhost:5173
# Orígenes permitidos para CORS (separados por coma). En producción: https://tu-sitio.vercel.app
CORS_ORIGIN=http://localhost:5173

# --- MySQL ---
# Opción A: una sola URL (Railway la entrega como MYSQL_URL)
# DATABASE_URL=mysql://usuario:clave@host:3306/base
# Opción B: variables separadas
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=protec
# true si tu proveedor exige conexión SSL
DB_SSL=false

# --- JWT (cadena larga y aleatoria, mínimo 32 caracteres en producción) ---
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Cloudinary (OBLIGATORIO en producción para guardar fotografías) ---
CLOUDINARY_CLOUD_NAME=ronh4rp1
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=protec

# --- Stripe (pagos con tarjeta) ---
# Claves en https://dashboard.stripe.com/apikeys (usa sk_test_... para pruebas)
STRIPE_SECRET_KEY=
# Secreto del endpoint de webhook: https://tu-backend/api/payments/stripe/webhook
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=mxn

# --- Correo SMTP (Brevo, Resend, etc.) para recuperar contraseñas ---
# Brevo:  SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_USER=<login SMTP>  SMTP_PASS=<clave SMTP>
# Resend: SMTP_HOST=smtp.resend.com       SMTP_PORT=465  SMTP_SECURE=true  SMTP_USER=resend  SMTP_PASS=<API key>
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=c21e88001@smtp-brevo.com
SMTP_PASS=
# Remitente verificado en Brevo (Remitentes e IP -> Remitentes)
MAIL_FROM="PROTEC <cristianpadilla1108@gmail.com>"
# Minutos de validez del enlace de recuperación
RESET_TOKEN_MINUTES=30
# Horas de validez del enlace para confirmar el correo al registrarse
VERIFY_TOKEN_HOURS=48
# La verificación de correo se activa automáticamente cuando hay SMTP configurado.
# EMAIL_VERIFICATION=false   # solo para desactivarla explícitamente

# --- Datos del negocio (pie de los correos) ---
BUSINESS_NAME=PROTEC
BUSINESS_LEGAL_NAME="Cristian Javier Padilla Cornejo, Jessica Pedraza Quintana, Gael Ceja de Anda, Edwin Daniel Carvajal López y Mario Abraham Murillo García"
BUSINESS_ADDRESS=
BUSINESS_EMAIL=cristianpadilla1108@gmail.com
BUSINESS_PHONE=

# --- Administrador inicial (solo para `npm run admin:create`) ---
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
